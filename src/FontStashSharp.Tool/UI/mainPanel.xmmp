<Project>
  <Project.ExportOptions Namespace="FontStashSharp.Tool.UI" Class="MainPanel" OutputPath="D:\Projects\FontStashSharp\src\FontStashSharp.Tool\UI" FieldsVisibility="Private" />
  <VerticalSplitPane Id="_panelRoot">
    <HorizontalSplitPane Id="_panelTop">
      <Panel Id="_panelTextContainer" />
      <VerticalStackPanel Id="_panelRight">
        <ScrollViewer>
          <PropertyGrid Id="_propertyGridTextSettings" />
        </ScrollViewer>
      </VerticalStackPanel>
    </HorizontalSplitPane>
    <HorizontalSplitPane>
      <Grid ColumnSpacing="8" RowSpacing="8">
        <Grid.DefaultRowProportion Type="Auto" />
        <Grid.ColumnsProportions>
          <Proportion Type="Auto" />
          <Proportion Type="Fill" />
        </Grid.ColumnsProportions>
        <Grid.RowsProportions>
          <Proportion Type="Auto" />
          <Proportion Type="Auto" />
          <Proportion Type="Fill" />
        </Grid.RowsProportions>
        <Label Text="Font" />
        <HorizontalStackPanel Spacing="8" Grid.Column="1">
          <TextBox Readonly="True" Width="300" Id="_textFontFile" />
          <Button Id="_buttonBrowseFont">
            <Label Text="Browse..." />
          </Button>
          <Button Id="_buttonResetFont">
            <Label Text="Reset" />
          </Button>
          <Label Text="Size" />
          <SpinButton Maximum="128" Minimum="4" Value="32" Integer="True" Width="50" Id="_spinButtonFontSize" />
        </HorizontalStackPanel>
        <Label Text="Scale" VerticalAlignment="Center" Grid.Row="1" />
        <HorizontalStackPanel Spacing="8" Grid.Column="1" Grid.Row="1">
          <HorizontalSlider Minimum="1" Maximum="8" Value="3" Width="200" Id="_sliderScale" />
          <Label Text="3" Id="_labelScale" />
        </HorizontalStackPanel>
        <Label Text="Text" Grid.Row="2" />
        <TextBox Text="Plain text./n/dsShadow text./dd/n/dtStroked text." Multiline="True" VerticalAlignment="Stretch" Id="_text" Grid.Column="1" Grid.Row="2" />
      </Grid>
    </HorizontalSplitPane>
  </VerticalSplitPane>
</Project>